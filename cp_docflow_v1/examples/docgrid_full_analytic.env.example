# Copy this file outside the repository, edit the writable output roots, then:
#   source /path/to/your/docgrid_full_analytic.env
#   bash slurm/docgrid_v2/00_render_analytic_gt_array.sh --partition=a100
#   # after all array tasks are COMPLETED:
#   bash slurm/docgrid_v2/00_merge_analytic_gt.sh --partition=cpu
#   bash slurm/docgrid_v2/00_audit_data.sh --partition=cpu
#
# Never point a formal Gate run at the legacy flow_gt_path column. It is
# torchvision RAFT pseudo-label data, not geometric ground truth.

export DOCGRID_PYTHON=/path/to/qwen-training-env/bin/python

# Confirmed flat/rectified source column from the 116,016-row corpus.
export DOCGRID_ANALYTIC_INPUT_CSV=/juicefs-algorithm/data/IPT/zhuochu_yang/upwarp_img_1in10_white_0511/metadata_with_flow.csv
export DOCGRID_ANALYTIC_IMAGE_COLUMN=image
export DOCGRID_ANALYTIC_CATEGORY_COLUMN=category
export DOCGRID_ANALYTIC_VARIANTS=3
export DOCGRID_RENDER_SEED=1337
export DOCGRID_RENDER_HEIGHT=512
export DOCGRID_RENDER_WIDTH=512

# Choose a shard count no larger than the selected document count. Keep every
# output directory new and empty; the renderer/merger intentionally refuse
# overwrite and mixed-run reuse.
export DOCGRID_ANALYTIC_SHARDS=64
export DOCGRID_ANALYTIC_SHARD_ROOT=/path/to/writable/docgrid_v2_analytic_shards
export DOCGRID_ANALYTIC_MERGED_OUTPUT=/path/to/writable/docgrid_v2_analytic_merged

# Bind Stage 0 and Stage 1–4 to the immutable merged output.
export DOCGRID_TRAIN_MANIFEST="${DOCGRID_ANALYTIC_MERGED_OUTPUT}/manifests/train.jsonl"
export DOCGRID_VAL_MANIFEST="${DOCGRID_ANALYTIC_MERGED_OUTPUT}/manifests/val.jsonl"
export DOCGRID_TEST_MANIFEST="${DOCGRID_ANALYTIC_MERGED_OUTPUT}/manifests/test.jsonl"
export DOCGRID_AUDIT_OUTPUT=/path/to/writable/runs/docgrid_v2/stage0_audit
export DOCGRID_FROZEN_CONTRACT="${DOCGRID_AUDIT_OUTPUT}/frozen_contract.json"

# Set these only in a GPU environment compatible with the real local Qwen
# pipeline. Stage 4/5 will reject a missing/stale validation receipt.
export DOCGRID_QWEN_MODEL=/juicefs-algorithm/data/IPT/yuang_feng/DiffSynth-Studio/models/Qwen-Image-Edit
export DOCGRID_QWEN_VALIDATION_REPORT=/path/to/writable/runs/docgrid_v2/qwen_runtime_validation/report.json
# Stage4/5 wrappers default to 192G because Qwen uses CPU offload. Reduce only
# after measuring the real validation peak on the target cluster.
export DOCGRID_QWEN_HOST_MEM=192G
# export DOCGRID_QWEN_PROBE_IMAGE=/path/to/representative_warped_page.png
